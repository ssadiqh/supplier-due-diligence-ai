# Local database (Docker Compose)
POSTGRES_USER=diligence_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=supplier_diligence
DATABASE_URL=jdbc:postgresql://localhost:5432/supplier_diligence

# Azure OpenAI (populate when ready)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# ABN Lookup (populate when ready)
ABN_LOOKUP_GUID=your_abn_lookup_guid_here

# Application
APP_PORT=8080
APP_ENV=local
